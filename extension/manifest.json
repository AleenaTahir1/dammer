{
  "manifest_version": 3,
  "name": "Dammer — Tab Auto Refresh",
  "short_name": "Dammer",
  "version": "1.1.0",
  "description": "Private, lightweight auto-refresh for any tab. Randomised intervals, auto-stop, analog or digital timer. No tracking.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "idle",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Dammer — idle",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start or stop auto refresh"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'"
  }
}
